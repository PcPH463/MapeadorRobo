<Window x:Class="MapeadorRobo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MapeadorRobo"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- Barra de ferramentas estilo Windows -->
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="20">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Novo"/>
                <MenuItem Header="A_brir"/>
                <MenuItem Header="_Fechar"/>
                <Separator/>
                <MenuItem Header="_Salvar"/>
                <MenuItem Header="Salvar _Como"/>
            </MenuItem>
        </Menu>
        <!-- Barra de ferramentas estilo Windows -->
        
        <!-- Barra inferiror para detalhes e a opção de Zoom -->
        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Height="30">

            <StatusBarItem Content="NomeDoArquivo.json"/>

            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <TextBlock Text="Zoom:" Background="Transparent" VerticalAlignment="Center"/>
                    <Slider x:Name="ZoomSlider" Width="100" Value="100" Minimum="50" Maximum="200" Margin="5,0" IsSnapToTickEnabled="True" TickFrequency="10" TickPlacement="BottomRight"/>
                    <TextBox 
                        Text="{Binding ElementName=ZoomSlider, Path=Value, 
                        Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                        Width="35" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
        <!-- Barra inferiror para detalhes e a opção de Zoom -->
        
        <!-- Barra de ferramentas lateral -->
        <Expander Grid.Row="1" Grid.Column="0" Background="Beige" BorderBrush="SaddleBrown" ExpandDirection="Right">
            <Border Width="100" BorderThickness="2"/>
        </Expander>
    </Grid>
</Window>
